# The dashboard runs fully in mock mode without any secrets.
APP_PORT=8787

# Approval-first HubSpot connector. Writes stay disabled unless BOTH values are set.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_ENABLE_WRITES=false

# Optional OpenAI-compatible aggregate-only brief provider.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
